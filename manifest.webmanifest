{"name":"PCBView — placas e esquemáticos","short_name":"PCBView","description":"Visualizador de placas (.pcb, .PcbDoc) e esquemáticos (.sch, .SchDoc), com 3D e geração de esquemático a partir da placa.","lang":"pt-BR","id":"./","start_url":"./","scope":"./","display":"standalone","background_color":"#0d1117","theme_color":"#161b22","categories":["productivity","utilities"],"icons":[{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml"},{"src":"icons/icon-192.png","sizes":"192x192","type":"image/png"},{"src":"icons/icon-512.png","sizes":"512x512","type":"image/png"},{"src":"icons/maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}],"file_handlers":[{"action":"./","accept":{"application/x-pcad-pcb":[".pcb"],"application/x-pcad-sch":[".sch"],"application/x-altium-pcbdoc":[".pcbdoc"],"application/x-altium-schdoc":[".schdoc"]}}],"launch_handler":{"client_mode":"focus-existing"}}